---
import type { Project } from '../data/profile';
import TechTag from './TechTag.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul class="projects">
  {
    projects.map((project) => (
      <li class:list={['project', { 'project--link': project.href }]}>
        <p class="project__context">{project.context}</p>
        <h3 class="project__name">
          {project.href ? (
            <a class="project__link" href={project.href} target="_blank" rel="noopener noreferrer">
              {project.name}
              <span class="project__arrow" aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          ) : (
            project.name
          )}
        </h3>
        <p class="project__description">{project.description}</p>
        {project.tags.length > 0 && (
          <ul class="tag-list project__tags" aria-label="Tecnologías">
            {project.tags.map((tag) => (
              <TechTag name={tag} size="sm" />
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<style>
  .projects {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
  }

  @media (min-width: 1024px) {
    .projects {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  /* Only linked cards get interactive affordances; static cards should not look clickable. */
  .project--link {
    transition:
      border-color 150ms ease,
      transform 150ms ease,
      box-shadow 150ms ease;
  }

  .project--link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .project--link:active {
    transform: translateY(0);
  }

  .project--link:has(.project__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .project__context {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project__name {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .project__link {
    text-decoration: none;
  }

  /* Stretched link: the whole card is the click target. */
  .project__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project__link:focus-visible {
    outline: none;
  }

  .project__arrow {
    display: inline-block;
    margin-left: 4px;
    color: var(--accent);
    transition: transform 150ms ease;
  }

  .project--link:hover .project__arrow {
    transform: translate(2px, -2px);
  }

  .project__description {
    color: var(--text-muted);
  }

  .project__tags {
    margin-top: auto;
    padding-top: var(--space-1);
  }
</style>
