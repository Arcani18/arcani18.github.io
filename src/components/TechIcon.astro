---
import { techIcons } from '../data/techIcons';

interface Props {
  name: string;
}

const { name } = Astro.props;
const icon = techIcons[name];

// "Domain-Driven Design" -> "DDD", "WebSockets" -> "WS", "Cells" -> "C", "CI/CD" -> "CI".
const capitals = name.match(/[A-Z]/g) ?? [name[0]];
const monogram = (capitals.length > 3 ? capitals.slice(0, 2) : capitals).join('');
---

{
  icon ? (
    <svg class="tech-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={icon.path} />
    </svg>
  ) : (
    <span class="tech-icon tech-icon--monogram" aria-hidden="true">
      {monogram}
    </span>
  )
}

<style>
  /* Size comes from the parent (TechTag) through --tech-icon-size. */
  .tech-icon {
    flex-shrink: 0;
    width: var(--tech-icon-size, 18px);
    height: var(--tech-icon-size, 18px);
  }

  .tech-icon--monogram {
    display: inline-grid;
    place-items: center;
    border-radius: 4px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: calc(var(--tech-icon-size, 18px) * 0.44);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
