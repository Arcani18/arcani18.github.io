---
import TechIcon from './TechIcon.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>
      © {year} {name}. Hecho con
      <span class="footer__tech"><TechIcon name="Astro" />Astro</span>
      y desplegado en
      <span class="footer__tech"><TechIcon name="Cloudflare" />Cloudflare</span>.
    </p>
    <a class="footer__top" href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .footer__tech {
    --tech-icon-size: 14px;

    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text);
    vertical-align: bottom;
  }

  .footer__top {
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer__top:hover {
    color: var(--text);
  }
</style>
